{
  "name": "minimalist-social-network",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual minimal social network with text and image posts, likes, comments, reposts, following feed, live notifications and direct messages — Next.js, tRPC, Prisma, PostgreSQL and Pusher.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@tanstack/react-query": "^5.85.5",
    "@trpc/client": "^11.5.1",
    "@trpc/react-query": "^11.5.1",
    "@trpc/server": "^11.5.1",
    "framer-motion": "^12.23.12",
    "next": "16.3.2",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superjson": "^2.2.2",
    "zod": "^4.0.17"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
